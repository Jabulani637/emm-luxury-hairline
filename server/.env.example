# Shopify Store configuration
SHOPIFY_STORE=your-shop.myshopify.com
SHOPIFY_STORE_DOMAIN=your-shop.myshopify.com

# Storefront API — public token (no shpat_ prefix). Used for cart/checkout on the frontend.
SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token
SHOPIFY_PUBLIC_ACCESS_TOKEN=your_storefront_access_token

# Admin API — private token (usually shpat_ prefix). REQUIRED for custom orders / Draft Orders.
# Generate one via Shopify Admin → Settings → Apps and sales channels → Develop apps
# Required scopes: write_draft_orders, read_products, write_customers
SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_access_token

# Shopify API versions
SHOPIFY_STOREFRONT_API_VERSION=2024-10
SHOPIFY_ADMIN_API_VERSION=2024-10

# Webhook secret (for future use)
WEBHOOK_SECRET=your_webhook_shared_secret

# Server configuration
PORT=3000
CORS_ORIGIN=http://localhost:8000

# Optional: local directory for JSON backups of custom orders
CUSTOM_ORDERS_DIR=

# Optional cache settings
CACHE_TTL_SECONDS=300

# Recommended in production: use Redis and set REDIS_URL
REDIS_URL=
