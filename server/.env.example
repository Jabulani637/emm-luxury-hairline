# Shopify configuration
SHOPIFY_STORE=your-shop.myshopify.com
STOREFRONT_TOKEN=your_storefront_access_token
WEBHOOK_SECRET=your_webhook_shared_secret
# Optional: Admin API token if needed for admin tasks
ADMIN_TOKEN=

# Server configuration
PORT=3000
CORS_ORIGIN=http://localhost:8000

# Optional cache settings
CACHE_TTL_SECONDS=300

# Recommended in production: use Redis and set REDIS_URL
REDIS_URL=
