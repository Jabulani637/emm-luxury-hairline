# ============================================================================
#  EMM LUXURY HAIR — environment variables
#  Copy this file to <project root>/.env  (NOT server/.env — the server loads
#  the one at the project root).
# ============================================================================

# -- Shopify store -----------------------------------------------------------
# The .myshopify.com domain, e.g. t1z0ta-pp.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API token — reads products, builds carts, calculates shipping.
# Shopify admin → Settings → Apps and sales channels → Sales channels →
# Develop apps → your app → Admin API integration → Storefront API access token.
# It has NO shpat_ prefix and is designed to be exposed to browsers.
SHOPIFY_PUBLIC_ACCESS_TOKEN=your_storefront_access_token

# Legacy aliases. The server still reads these so an existing deployment keeps
# working, but a new setup should leave every one of them UNSET and use the
# canonical names above:
#   SHOPIFY_STORE                -> SHOPIFY_STORE_DOMAIN
#   SHOPIFY_STOREFRONT_TOKEN     -> SHOPIFY_PUBLIC_ACCESS_TOKEN
#   STOREFRONT_TOKEN             -> SHOPIFY_PUBLIC_ACCESS_TOKEN
#   SHOPIFY_ADMIN_TOKEN          -> SHOPIFY_ADMIN_ACCESS_TOKEN
#   SHOPIFY_ADMIN_API_TOKEN      -> SHOPIFY_ADMIN_ACCESS_TOKEN
# If two names for the same credential are both set the canonical one wins and
# the server logs a warning naming the duplicate.

SHOPIFY_STOREFRONT_API_VERSION=2025-10

# -- Shopify Admin API token -------------------------------------------------
# REQUIRED for custom orders and contact enquiries. Without it those forms
# cannot write draft orders, and submissions only land in the ephemeral local
# mirror — meaning they disappear on the next deploy.
#
# Grant the custom app these Admin API scopes:
#   write_draft_orders   create the order
#   read_orders          required for order webhooks + webhook registration
#   write_customers      link/create the customer record
#   write_webhooks       register webhook subscriptions
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_access_token
SHOPIFY_ADMIN_API_VERSION=2025-10

# -- Webhooks ----------------------------------------------------------------
# Must be your custom app's CLIENT SECRET. Shopify signs every webhook payload
# with it; the server rejects any delivery it cannot reproduce.
# Get it from: Shopify admin → Settings → Apps and sales channels →
# Develop apps → your app → Client credentials.
WEBHOOK_SECRET=your_webhook_client_secret

# Register / update the subscriptions on the store:
#   npm run register:webhooks
# (topics default to ORDERS_CREATE, ORDERS_PAID)

# -- Server ------------------------------------------------------------------
PORT=3000

# -- Public URLs -------------------------------------------------------------
# The frontend asks GET /api/config for these, so nothing is hardcoded in the
# site. BACKEND_URL must be the public https origin of this API service.
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# In production:
#   BACKEND_URL=https://api.emmluxuryhair.com
#   FRONTEND_URL=https://www.emmluxuryhair.com

# -- Cache -------------------------------------------------------------------
# Seconds that catalog responses (products, collections, country list) are
# reused instead of re-querying Shopify. Order webhooks invalidate it instantly.
CACHE_TTL_SECONDS=300

# -- Local data mirror (optional) --------------------------------------------
# Directory for the best-effort local copies of custom orders, contact
# enquiries and webhook payloads. Defaults to <project root>/data.
#
# Shopify is the source of truth. On Render's free plan this directory is
# wiped on every deploy, so never treat it as your order record.
# LOCAL_DATA_DIR=

# -- Debugging only ----------------------------------------------------------
# Reflects any request origin with credentials. Ignored when NODE_ENV is
# production. Never enable it there.
# CORS_ALLOW_ALL=0

# -- Customer reviews --------------------------------------------------------
# Where approved reviews live. Supabase is the only durable option on Render's
# free plan: without it, reviews are written to data/reviews/reviews.json and
# every deploy deletes them.
#
#   SUPABASE_URL         Project Settings -> Data API -> URL
#   SUPABASE_SECRET_KEY  Project Settings -> API Keys -> Secret key (sb_secret_...)
#                        NEVER put the secret key in frontend code or commit it.
#
# Then run supabase/schema.sql once in the SQL editor, and make sure the
# project exposes that table through the Data API (Settings -> API).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_xxx
# SUPABASE_REVIEWS_TABLE=product_reviews

# Password for /admin/reviews, the moderation queue. Leave unset and the queue
# refuses every request, so the site keeps working but nobody can approve a
# review. Anything long and unique; it is only ever typed by you.
# ADMIN_PASSWORD=
