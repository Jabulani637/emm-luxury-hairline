{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; img-src 'self' data: https://cdn.shopify.com; media-src 'self' https://cdn.shopify.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.emmluxuryhair.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin/reviews",
      "destination": "https://api.emmluxuryhair.com/admin/reviews",
      "permanent": true
    },
    {
      "source": "/products/product",
      "destination": "/collections/all",
      "permanent": true
    },
    {
      "source": "/collections/collection",
      "destination": "/collections/all",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/products/([^/]+)",
      "destination": "/pages/product"
    }
  ]
}
