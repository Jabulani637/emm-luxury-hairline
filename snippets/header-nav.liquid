{%- comment -%}
Header navigation snippet (data-driven from Shopify Navigation)

Usage: include this snippet in your theme header where you want the navigation to appear.
Replace `main-menu` with your menu handle if different (e.g., `header-menu`).

This snippet outputs:
- A top-level ul.main-nav with li.nav-item elements
- If a link has children (link.links), a dropdown card is rendered
- Accessibility: uses aria-expanded, aria-controls, and supports :focus-within
{%- endcomment -%}

{%- assign menu = linklists.main-menu -%}
{%- comment -%} If your menu handle is different, change the above line to linklists['your-handle'] {%- endcomment -%}

<nav class="main-nav" role="navigation" aria-label="Main navigation">
  <ul class="nav-list">
	{%- for link in menu.links -%}
		<li class="nav-item{% if link.links.size > 0 %} has-dropdown{% endif %}" data-nav-index="{{ forloop.index0 }}">
		<a href="{{ link.url }}" class="nav-link" aria-haspopup="{% if link.links.size > 0 %}true{% else %}false{% endif %}" aria-expanded="false"{% if link.links.size > 0 %} aria-controls="dropdown-{{ forloop.index0 }}"{% endif %}>{{ link.title }}</a>

		{%- if link.links.size > 0 -%}
			<div id="dropdown-{{ forloop.index0 }}" class="dropdown" role="menu" aria-hidden="true">
			<ul class="dropdown-list">
			  {%- for child in link.links -%}
				<li class="dropdown-item" role="none">
				  <a role="menuitem" href="{{ child.url }}" class="dropdown-link">{{ child.title }}</a>
				</li>
			  {%- endfor -%}
			</ul>
		  </div>
		{%- endif -%}
	  </li>
	{%- endfor -%}
  </ul>
</nav>
